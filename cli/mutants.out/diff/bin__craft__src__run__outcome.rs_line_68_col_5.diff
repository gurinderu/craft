 /// A failed exit's outcome.
 fn quit(host: &Host, code: Option<i32>, stderr: &str, stdout: &str) -> Outcome {
     let said = format!("{stderr}\n{stdout}");
     if let Some(limit) = usage_limit_text(&said) {
         return Outcome::Limit(limit);
     }
