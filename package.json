{
  "name": "craft",
  "private": true,
  "type": "module",
  "description": "craft: AI code review and code-quality skills for coding agents. This file holds the pi package manifest and the repo's dev tooling; craft itself ships no runtime dependencies.",
  "pi": {
    "extensions": [
      "./integrations/pi/pi-extension.mjs"
    ],
    "skills": [
      "./integrations/pi/skills"
    ],
    "prompts": [],
    "themes": []
  },
  "scripts": {
    "prepare": "git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "test": "vitest run --config integrations/shared/config/vitest.config.mjs",
    "gate": "node integrations/shared/gate.mjs",
    "lint": "eslint --config integrations/shared/config/eslint.config.mjs integrations/shared integrations/pi integrations/opencode/plugin integrations/shared/config/knip.config.js integrations/shared/config/.dependency-cruiser.mjs --max-warnings 0",
    "format": "prettier --write .",
    "check:format": "prettier --check .",
    "build:engines": "node integrations/shared/build-engines.mjs",
    "check:engines": "node integrations/shared/build-engines.mjs --check",
    "check:workflows": "node integrations/shared/check-workflows.mjs",
    "check:workflow-size": "node integrations/shared/check-workflow-size.mjs",
    "check:skills": "node integrations/shared/check-skills.mjs",
    "check:evals": "node integrations/shared/check-evals.mjs",
    "check:plugin": "node integrations/shared/validate-plugin.mjs",
    "check:types": "npm --prefix integrations/opencode/plugin run typecheck",
    "check:types:lib": "integrations/opencode/plugin/node_modules/.bin/tsc -p integrations/shared/tsconfig.json",
    "check:types:workflows": "node integrations/shared/check-workflow-types.mjs",
    "check:opencode-frontmatter": "python3 integrations/opencode/scripts/check-frontmatter.py agent integrations/opencode/agents/*.md && python3 integrations/opencode/scripts/check-frontmatter.py command integrations/opencode/commands/*.md",
    "check:dead": "knip --config integrations/shared/config/knip.config.js --no-progress",
    "check:dead:production": "knip --config integrations/shared/config/knip.config.js --no-progress --production",
    "check:dup": "node integrations/shared/check-dup.mjs",
    "check:dup:baseline": "jscpd --update-baseline",
    "check:deps": "depcruise --config integrations/shared/config/.dependency-cruiser.mjs integrations/shared integrations/pi integrations/opencode/plugin integrations/claude-code/src",
    "test:mutation": "stryker run integrations/shared/config/stryker.config.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "22.20.5",
    "dependency-cruiser": "18.5.0",
    "esbuild": "0.28.2",
    "eslint": "^9.39.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "jscpd": "5.4.0",
    "knip": "6.39.0",
    "prettier": "3.10.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
