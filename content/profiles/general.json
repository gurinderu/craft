    { "id": "intent", "brief": "lens-briefs/general-intent", "model": "opus", "wholeDiff": true },
    { "id": "tests", "brief": "lens-briefs/general-tests", "model": "opus" },
    { "id": "maintainability", "brief": "lens-briefs/general-maintainability", "model": "opus", "conditional": true, "signal": "new-or-large-file" },
