  "rollupRuleIds": [],
  "negativeSpace": { "newSurface": "exported function / class / type / interface / enum value / status value / DB column / table / migration / route / config key / object or struct field", "shapeUses": "lists, updates, deletes, cascades, serializes, orders, or authorizes" },
  "lenses": [
    { "id": "correctness", "brief": "lens-briefs/general-correctness", "model": "opus" },
