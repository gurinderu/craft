    { "id": "money", "brief": "lens-briefs/general-money", "model": "opus", "conditional": true, "signal": "money" },
    { "id": "concurrency", "brief": "lens-briefs/general-concurrency", "model": "opus" },
    { "id": "errors", "brief": "lens-briefs/general-errors", "model": "opus" },
