{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lens",
    "findings"
  ],
  "properties": {
    "lens": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "finding-item.schema.json"
      }
    },
    "consumers": {
      "type": "array",
      "description": "each line of the CONSUMERS list, marked once judged",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "site",
          "status"
        ],
        "properties": {
          "site": {
            "type": "string",
            "description": "<file>:<line> as the list names it"
          },
          "status": {
            "type": "string",
            "enum": [
              "checked",
              "not-relevant"
            ]
          }
        }
      }
    },
    "blocked": {
      "$ref": "blocked.schema.json"
    }
  }
}
