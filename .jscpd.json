{
  "path": ["integrations/shared", "integrations/pi", "integrations/opencode/plugin", "integrations/claude-code/src"],
  "format": ["javascript", "typescript"],
  "ignore": ["**/*.test.mjs", "**/node_modules/**", "integrations/shared/config/**", "integrations/shared/fixtures/**"],
  "crossFormats": ["js-ts"],
  "minTokens": 50,
  "minLines": 5,
  "maxSize": "10mb",
  "absolute": true,
  "reporters": ["console"],
  "baseline": ".jscpd-baseline.json",
  "failOnNewClones": 0,
  "failOnEmpty": true,
  "noTips": true
}
