#!/bin/sh
# Fast checks on the staged files only (wired by `npm ci`/`npm install` through the `prepare` script, which sets
# core.hooksPath to .githooks): Prettier on staged JS/TS/JSON/YAML, ESLint on the staged files in the `lint`
# script's scope, `cargo fmt --check` when Rust is staged. Each check runs only when its files are staged; a needed
# tool that is missing stops the commit with how to install it. It reads the working-tree copy of each staged file.
# Not the gate: run `npm run gate` before pushing.
set -u

root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -n "$staged" ] || exit 0

# The staged paths matching an extended regular expression, one per line.
pick() { printf '%s\n' "$staged" | grep -E "$1"; }

formattable=$(pick '\.(js|mjs|cjs|ts|mts|cts|json|yml|yaml)$')
lintable=$(pick '^((lib|integrations/opencode/plugin)/.*\.(js|mjs|cjs|ts)|knip\.config\.js|\.dependency-cruiser\.mjs)$' | grep -v '/node_modules/')
rust=$(pick '^cli/.*\.rs$')

bin=node_modules/.bin
# Stop when a check has files to read but no tool to read them with.
need() {
  [ -x "$bin/$1" ] && return 0
  echo "pre-commit: $1 is not installed in this worktree — run: npm ci && npm ci --prefix integrations/opencode/plugin" >&2
  exit 1
}

failed=0

if [ -n "$formattable" ]; then
  need prettier
  # One path per word: the repository's paths hold no whitespace. .prettierignore still applies.
  # shellcheck disable=SC2086
  if ! "$bin/prettier" --check --ignore-unknown --no-error-on-unmatched-pattern $formattable; then
    echo "pre-commit: formatting — run: npm run format (or npx prettier --write <file>), then stage again" >&2
    failed=1
  fi
fi

if [ -n "$lintable" ]; then
  need eslint
  # shellcheck disable=SC2086
  if ! "$bin/eslint" --max-warnings 0 --no-warn-ignored $lintable; then
    echo "pre-commit: lint — fix the findings above, then: npm run lint" >&2
    failed=1
  fi
fi

if [ -n "$rust" ]; then
  if ! command -v cargo >/dev/null 2>&1; then
    echo "pre-commit: Rust is staged but cargo is not on PATH — install the Rust toolchain to check its formatting" >&2
    exit 1
  fi
  if ! (cd cli && cargo fmt --check); then
    echo "pre-commit: Rust formatting — run: (cd cli && cargo fmt), then stage again" >&2
    failed=1
  fi
fi

exit "$failed"
