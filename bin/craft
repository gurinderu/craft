#!/bin/sh
# The craft binary of this plugin version, for the hosts that run it from a shell — Codex, pi, OpenCode
# (realm @nick/craft, node #500). It runs ~/.craft/bin/<version>/craft with every argument; when that is
# not there, it downloads the release's craft-<target>.tar.gz and its .sha256 (GitHub release v<version>),
# checks the SHA-256, unpacks the binary into that place (integrations/shared/craft-fetch.sh) and runs it. `--ensure` only
# fetches it; `--ensure --background` is the hourly background try (integrations/shared/craft-fetch.sh), and `--ensure --failure` prints
# the line that says a failed one, once per failing streak. The cache and its layout are
# integrations/shared/craft-bin.mjs's, so both deliveries share one copy. Windows is not covered: it has no sh.
#
#   CRAFT_BIN=<path>            run this binary instead (a local build)
#   CRAFT_RELEASE_BASE=<url>    download from here instead of the GitHub release
#   CRAFT_ROOT=<dir>            the plugin root the binary reads; by default the directory above this script
#
# A failure prints one line on stderr naming what is missing, and exits 127.
set -u

version=0.57.0 # x-release-please-version

die() {
  printf 'craft: %s\n' "$1" >&2
  exit 127
}

here=$(cd "$(dirname "$0")/.." && pwd -P) || die "cannot find the plugin root above $0"
CRAFT_ROOT=${CRAFT_ROOT:-$here}
export CRAFT_ROOT
CRAFT_FETCH_HELPERS=$here/integrations/shared

# `--ensure [--background | --failure]`: only make sure the binary of this version is in the cache, and run nothing.
if [ "${1:-}" = --ensure ]; then
  [ -z "${CRAFT_BIN:-}" ] || exit 0
  [ -n "${HOME:-}" ] || die "HOME is not set: no place for ~/.craft/bin/$version"
  . "$here/integrations/shared/craft-fetch.sh" || die "cannot read $here/integrations/shared/craft-fetch.sh"
  case ${2:-} in
    --background) craft_fetch_background "$version" ;;
    --failure) craft_fetch_failure "$version" || : ;;
    *) craft_fetch "$version" ;;
  esac
  exit 0
fi
if [ -n "${CRAFT_BIN:-}" ]; then
  [ -x "$CRAFT_BIN" ] && [ -f "$CRAFT_BIN" ] || die "CRAFT_BIN=$CRAFT_BIN is not an executable file"
  exec "$CRAFT_BIN" "$@"
fi

[ -n "${HOME:-}" ] || die "HOME is not set: no place for ~/.craft/bin/$version"
bin=$HOME/.craft/bin/$version/craft
if [ -f "$bin" ] && [ -x "$bin" ]; then
  exec "$bin" "$@"
fi
# The download itself is integrations/shared/craft-fetch.sh's, shared with the hooks (realm @nick/craft, node #550).
. "$here/integrations/shared/craft-fetch.sh" || die "cannot read $here/integrations/shared/craft-fetch.sh"
craft_fetch "$version"
exec "$bin" "$@"
